# Copia este archivo como .env y completa los valores (el .env no se sube a git).
# Sin SUPABASE_URL o SUPABASE_SECRET_KEY el servidor funciona 100 % local.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...). Solo el servidor.
SUPABASE_SECRET_KEY=

# Opcionales
# PORT=3000
# DB_PATH=data/restaurante.db

# Inicio de sesión (obligatorio: sin JWT_SECRET el servidor no arranca)
# Mínimo 32 caracteres. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Usuarios que se crean en el primer arranque (solo si la tabla usuarios está vacía).
# Formato: usuario:contraseña,usuario2:contraseña2 (usuario 3–32 caracteres a-z 0-9 . _ -;
# contraseña de al menos 8 caracteres). Después de crearlos se puede borrar esta línea.
USUARIOS_INICIALES=

# API gateway (obligatorio: sin API_KEYS el servidor no arranca)
# Una llave por aplicación cliente, formato nombre:llave,nombre2:llave2 (llave de al menos
# 16 caracteres, sin comas). Varias a la vez permiten rotar sin cortar el servicio; ver
# docs/api-gateway.md. Para generar una llave:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEYS=
