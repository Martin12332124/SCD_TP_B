# Copia este archivo como .env y completa los valores (el .env no se sube a git).
# Sin SUPABASE_URL o SUPABASE_SECRET_KEY el servidor funciona 100 % local.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...). Solo el servidor.
SUPABASE_SECRET_KEY=

# Opcionales
# PORT=3000
# DB_PATH=data/restaurante.db
